# Web
NEXT_PUBLIC_APP_NAME=MPA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Auth/session
SESSION_COOKIE_NAME=mpa_session

# Optional — email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — Stripe (resident Pay Now / FIN-OPS)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — COM-002 SaaS Checkout (Slice C) — dedicated webhook + approved module Price ids
# Internal mapping names use PROFESSIONAL — not a customer-facing tier (ADR-019).
STRIPE_SAAS_WEBHOOK_SECRET=
STRIPE_PRICE_PM_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PM_PROFESSIONAL_ANNUAL=
# Legacy / unused for Checkout readiness — do not require for PM self-serve
STRIPE_PRICE_PM_BUSINESS_MONTHLY=
STRIPE_PRICE_PM_BUSINESS_ANNUAL=
# Display-only FO/Complete Prices (Pricing transparency; Checkout still FO_READY-gated)
STRIPE_PRICE_FO_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_FO_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_ANNUAL=
# Set to "true" only after Stripe Tax registration is active
STRIPE_SAAS_AUTOMATIC_TAX=

# Optional — SignWell (e-sign)
SIGNWELL_API_KEY=
SIGNWELL_WEBHOOK_ID=
SIGNWELL_TEST_MODE=
