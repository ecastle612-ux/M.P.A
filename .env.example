# Web
NEXT_PUBLIC_APP_NAME=MPA
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Auth/session
SESSION_COOKIE_NAME=mpa_session

# Optional — email (Resend). Production from must be a verified domain, not resend.dev.
# Example: My Property Assistant <noreply@my-property-assistant.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — Stripe (resident Pay Now / FIN-OPS)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# FIN-OPS Connect destination only. Do not overwrite STRIPE_WEBHOOK_SECRET or STRIPE_SAAS_WEBHOOK_SECRET.
STRIPE_CONNECT_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — COM-002 SaaS Checkout (Slice C+) — dedicated webhook
STRIPE_SAAS_WEBHOOK_SECRET=
STRIPE_PRICE_PM_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PM_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_PM_BUSINESS_MONTHLY=
STRIPE_PRICE_PM_BUSINESS_ANNUAL=
# Unit-volume Checkout Price registry (future) — do not create Prices / set Production in Slice 3
STRIPE_PRICE_PM_BASE_MONTHLY=
STRIPE_PRICE_PM_BASE_ANNUAL=
STRIPE_PRICE_COMPLETE_BASE_MONTHLY=
STRIPE_PRICE_COMPLETE_BASE_ANNUAL=
STRIPE_PRICE_UNIT_BLOCK_MONTHLY=
STRIPE_PRICE_UNIT_BLOCK_ANNUAL=
# Optional — display-only FO/Complete professional Prices (Pricing transparency; Checkout still FO_READY-gated)
STRIPE_PRICE_FO_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_FO_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_ANNUAL=
# Set to "true" only after Stripe Tax registration is active
STRIPE_SAAS_AUTOMATIC_TAX=

# Optional — SignWell (e-sign)
SIGNWELL_API_KEY=
SIGNWELL_WEBHOOK_ID=
SIGNWELL_TEST_MODE=

# Optional — STAB-006 observability (Sentry). Local/dev works without these.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Optional — STAB-015. Demo APIs disabled on Vercel Production unless "true".
DEMO_ENABLED=
