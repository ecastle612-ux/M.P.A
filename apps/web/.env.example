NEXT_PUBLIC_APP_NAME=MPA
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SESSION_COOKIE_NAME=mpa_session

# Optional — team invites / notices (honesty path: accept link in app)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — resident online payments (Checkout). Manual payments work without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — COM-002 SaaS Checkout (dedicated webhook)
STRIPE_SAAS_WEBHOOK_SECRET=
# Legacy display / transitional PM Prices (not unit-volume registry)
STRIPE_PRICE_PM_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PM_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_PM_BUSINESS_MONTHLY=
STRIPE_PRICE_PM_BUSINESS_ANNUAL=
# Unit-volume Checkout Price registry (Slice 3+) — do NOT create Prices or set Production from Slice 3
STRIPE_PRICE_PM_BASE_MONTHLY=
STRIPE_PRICE_PM_BASE_ANNUAL=
STRIPE_PRICE_COMPLETE_BASE_MONTHLY=
STRIPE_PRICE_COMPLETE_BASE_ANNUAL=
STRIPE_PRICE_UNIT_BLOCK_MONTHLY=
STRIPE_PRICE_UNIT_BLOCK_ANNUAL=
# Optional — display-only FO/Complete professional Prices (Pricing transparency; Checkout still FO_READY-gated)
STRIPE_PRICE_FO_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_FO_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_COMPLETE_PROFESSIONAL_ANNUAL=
STRIPE_SAAS_AUTOMATIC_TAX=

# Optional — e-sign. Offline signed lease path works without these.
SIGNWELL_API_KEY=
SIGNWELL_WEBHOOK_ID=
# Defaults to test mode unless explicitly set to "false"
SIGNWELL_TEST_MODE=

# Optional — STAB-006 observability (Sentry). Local/dev works without these.
# Do not set Production values from this repo task — configure in Vercel when authorized.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Optional — STAB-015. Demo APIs are disabled on Vercel Production unless "true".
DEMO_ENABLED=
